# Copy this file to .env. Keep secrets in the ignored ./secrets directory,
# not in this file. See README.md for the required first-deployment migration.

# Database
DB_USER=maildt
DB_NAME=maildt
DB_HOST=db
DB_PORT=5432
DB_PASSWORD_FILE=./secrets/db_password

# Flask authentication
ADMIN_USER=maildt-admin
ADMIN_PASSWORD_FILE=./secrets/admin_password
ADMIN_TOTP_FILE=./secrets/admin_totp
SESSION_KEY_FILE=./secrets/session_key

# SMTP (sending and the exact diagnostic egress allowlist)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASSWORD_FILE=./secrets/smtp_password
SMTP_DIAGNOSTIC_ALLOWED_HOSTS=smtp.example.com
SMTP_DIAGNOSTIC_ALLOWED_PORTS=465

# IMAP (receiving/checking)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD_FILE=./secrets/imap_password

# Application settings
SEND_INTERVAL=3600
CHECK_INTERVAL=30
ALERT_THRESHOLD=300

# Alerting. Webhook URLs often contain credentials; prefer *_FILE when mounting
# additional secrets into the container.
DISCORD_WEBHOOK_URL=
WEBHOOK_TIMEOUT=10
WEBHOOK_URL=
ALERT_MAIL_RECIPIENT=admin@example.com

# Trust forwarded headers only from these exact immediate-proxy CIDRs.
# Leave empty when MailDT is reached directly.
TRUSTED_PROXY_CIDRS=
BIND_ADDRESS=127.0.0.1
PORT=5000

# External browser tools
ENABLE_WHOIS=true
WHOIS_URL=https://whois.reitetschlaeger.com
ENABLE_WEBCHECK=true
WEBCHECK_URL=https://webcheck-512351112734521.reitetschlaeger.com/
